# Firebase config — load at build time via eas.json secrets or app.config.ts
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Set to "true" to point the app at the local Firebase emulator suite
EXPO_PUBLIC_USE_FIREBASE_EMULATORS=false

# Sentry
EXPO_PUBLIC_SENTRY_DSN=

# Cloud Functions secrets (do NOT commit; use `firebase functions:secrets:set`)
# ANTHROPIC_API_KEY=
# PERSPECTIVE_API_KEY=
# GOOGLE_VISION_API_KEY=
